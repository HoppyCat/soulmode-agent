{
  "name": "soulmode-agent",
  "main": "src/api/index.ts",
  "compatibility_date": "2025-01-01",
  "vars": {
    "PUBLIC_AGENT_NAME": "Galaxie",
    "AGENT_MODEL": "claude-sonnet-4-5-20250929",
    "ALLOWED_FETCH_HOSTS": "raw.githubusercontent.com,gist.githubusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soulmode-agent-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "src/api/migrations"
    }
  ]
}
